# Copy to backend/.env (gitignored). Never put real secrets in this example file.

# PostgreSQL 16 (docker: postgres:16-alpine on port 5433)
DATABASE_URL=postgresql://postgres:tower@localhost:5433/tower

# Meko shared notebook. Leave MEKO_MCP_URL empty to use the local notebook table stand-in.
MEKO_MCP_URL=
MEKO_API_KEY=
MEKO_DATAPACK=content-team

# Summarizer: local Ollama. Leave OLLAMA_MODEL empty to use the counted fallback digest.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
# qwen2.5:1.5b gives better wording (~2x slower); both run on a laptop CPU

# Fixer (Claude Messages API). Without a key, rule templates propose fixes.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Claude Code runtime (claude-agent-sdk). Auth: ANTHROPIC_API_KEY above, or the Claude Code CLI login.
CLAUDE_RUNTIME_ENABLED=true
CLAUDE_AGENT_MODEL=
CLAUDE_CLI_PATH=

# Codex runtime (codex app-server over stdio). Auth: the Codex CLI login (`codex login`).
# Pick a model your account allows: the app-server's model/list shows them (ChatGPT plans can't use every model).
CODEX_RUNTIME_ENABLED=true
CODEX_BIN=codex
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=on-request

# Recorded-transcript runtime for demos without credentials (records are labelled runtime=replay).
REPLAY_RUNTIME_ENABLED=false

# Runtime security
AGENT_WORKSPACE_ROOT=
AGENT_WORKSPACES=
AGENT_MAX_CONCURRENCY=2
AGENT_DEFAULT_TIMEOUT=300
AGENT_DEFAULT_MAX_TURNS=12
AGENT_DEFAULT_PERMISSION_MODE=default

# Backend auth. TOWER_API_TOKEN guards invoke/cancel (falls back to TOWER_INGEST_TOKEN).
TOWER_INGEST_TOKEN=change-me-to-a-random-32-char-secret
TOWER_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APPLY_GIT_COMMIT=false
