# Copy to .env.local. Read only on the server (by src/app/api/tower/[...path]/route.ts);
# nothing here is sent to the browser.
TOWER_API_URL=http://127.0.0.1:8000
TOWER_API_TOKEN=dev-ingest-token-change-me

# Google sign-in (optional). Without AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET the dashboard has no sign-in and
# answers only on localhost. Create an OAuth client (type "Web application") in Google Cloud Console >
# APIs & Services > Credentials, with the redirect URI  http://localhost:3100/api/auth/callback/google
# (and https://<your domain>/api/auth/callback/google for the server).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# any long random string, e.g. the output of: openssl rand -hex 32
AUTH_SECRET=
# the Google accounts that may use the dashboard, comma separated; nobody else can sign in
AUTH_ALLOWED_EMAILS=
