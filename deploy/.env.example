# Copy to deploy/.env (git-ignored) and fill in. setup.sh fills the secrets for you.

# Your domain, pointed at the server's IP. No domain? Use <server-ip>.sslip.io (free, works with HTTPS).
DOMAIN=203.0.113.10.sslip.io

# The one login in front of the whole UI. setup.sh asks for the password and stores only its hash.
UI_USER=admin
UI_PASSWORD_HASH=

# Secrets: long random strings (setup.sh generates them)
DB_PASSWORD=
TOWER_API_TOKEN=
TOWER_INGEST_TOKEN=

# Summarizer model, pulled into Ollama on first start
OLLAMA_MODEL=qwen2.5:0.5b

# Meko shared memory (optional): a user API key from Meko, Settings > API Keys
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
MEKO_API_KEY=
MEKO_DATAPACK_ID=

# Agent models: empty = each provider's default (Codex on a ChatGPT plan may need e.g. gpt-5.6-terra)
CODEX_MODEL=
CLAUDE_AGENT_MODEL=
AGENT_MAX_CONCURRENCY=2
